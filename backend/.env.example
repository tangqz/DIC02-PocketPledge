# Copy this file to backend/.env for local debugging.
MEDIA_AI_USE_REAL_DIFY=1

# Dify base endpoint
DIFY_API_BASE=http://your-dify-host/v1
DIFY_CHAT_ENDPOINT=/chat-messages
DIFY_FILE_UPLOAD_ENDPOINT=/files/upload
DIFY_VISION_ENDPOINT=/workflows/run
DIFY_SYSTEM_AGENT_ENDPOINT=/workflows/run

# Dify app keys
DIFY_SYSTEM_AGENT_API_KEY=app-your-system-agent-key
DIFY_CHAT_API_KEY=app-your-chat-agent-key
DIFY_VISION_API_KEY=app-your-vision-workflow-key

# Copy this file to backend/.env for local debugging.
MEDIA_AI_ASR_PROVIDER=faster-whisper
MEDIA_AI_ASR_MODEL=small
MEDIA_AI_ASR_DEVICE=cpu
MEDIA_AI_ASR_COMPUTE_TYPE=int8
MEDIA_AI_ASR_LANGUAGE=zh

# Agent Backend configuration
AGENT_BACKEND=local

# Keep this fixed in local development so JWT tokens survive reload/restart.
AUTH_SECRET_KEY=replace-with-a-long-random-local-dev-secret

# Local Agent configuration
# Chat Model
LOCAL_CHAT_API_KEY=sk-placeholder
LOCAL_CHAT_API_BASE=https://api.openai.com/v1
LOCAL_CHAT_MODEL=gpt-4o
LOCAL_CHAT_TEMPERATURE=0.55

# Vision Model
LOCAL_VISION_API_KEY=sk-placeholder
LOCAL_VISION_API_BASE=https://api.openai.com/v1
LOCAL_VISION_MODEL=gpt-4o

# System Agent Model
LOCAL_AGENT_API_KEY=sk-placeholder
LOCAL_AGENT_API_BASE=https://api.openai.com/v1
LOCAL_AGENT_MODEL=gpt-4o
LOCAL_AGENT_TEMPERATURE=0.1